  DATA "EACH COLOUR AGAINST ITS OPPOSITE,"
  DATA "ROUND AND ROUND THE COLOUR WHEEL."
  DATA "PURE WHITE AGAINST PURE BLACK"
  DATA "LIGHT GREY AGAINST DARK GREY"
  DATA "FULL CONTRAST, FULL COLOUR"
  DATA "SOFTER CONTRAST, NO SATURATED RED"
  DATA 2,32,194,224
  DATA 5
  DATA "A MATHEMATICS STUDENT AT HARVARD,"
  DATA "TONY CONRAD READS W. GREY WALTER'S"
  DATA "BOOK [THE LIVING BRAIN]:"
  DATA "FLICKERING LIGHT CAN STIR"
  DATA "THE BRAIN'S OWN RHYTHMS."
  DATA 5
  DATA "A FEW YEARS LATER HE TURNS"
  DATA "A FLICKERING LIGHT FAR DOWN."
  DATA "WHAT HE SEES IS HALLUCINATORY."
  DATA "HIS TAPE RECORDER IS RUNNING"
  DATA "AND KEEPS THE MOMENT."
  DATA 6
  DATA "HE IS A MUSICIAN TOO, A VIOLINIST."
